# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://tahaif_user:tahaif_dev_password@localhost:5433/tahaif

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_random_64_char_string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Meilisearch ───────────────────────────────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=change_me

# ── Object Storage (MinIO locally / S3 in prod) ───────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=tahaif-media
S3_PUBLIC_URL=http://localhost:9000/tahaif-media
# Region used to sign receipt links (SigV4). MinIO accepts us-east-1.
S3_REGION=us-east-1

# ── Payments ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_PUBLISHABLE_KEY=pk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me

JAZZCASH_MERCHANT_ID=change_me
JAZZCASH_PASSWORD=change_me
JAZZCASH_INTEGRITY_SALT=change_me

EASYPAISA_STORE_ID=change_me
EASYPAISA_STORE_PASSWORD=change_me

# ── Messaging ─────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=change_me
TWILIO_AUTH_TOKEN=change_me
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+1234567890

RESEND_API_KEY=re_change_me
EMAIL_FROM=noreply@tahaif.com

# ── FX Rates ──────────────────────────────────────────────────────────────────
OPENEXCHANGERATES_APP_ID=change_me

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
ENVIRONMENT=development

# ── Frontend (Next.js public vars) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_change_me
NEXT_PUBLIC_MEILISEARCH_URL=http://localhost:7700
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=change_me
# Extra image hosts next/image may optimise (comma-separated, "*." allowed), e.g. the S3_PUBLIC_URL / CDN host.
NEXT_PUBLIC_IMAGE_HOSTS=
# Show the English/اردو switcher (ADR 0005). Keep off until all copy is translated and reviewed.
NEXT_PUBLIC_ENABLE_URDU=false

# ── Brand (white-label, ADR 0006) ────────────────────────────────────────────
# All customer-facing names/logos come from these. Leave LOGO_URL empty for the default gift icon.
NEXT_PUBLIC_BRAND_NAME=Tahaif
NEXT_PUBLIC_BRAND_LOCAL_NAME=تحائف
NEXT_PUBLIC_BRAND_LOGO_URL=
NEXT_PUBLIC_BRAND_TAGLINE=Send Gifts Across Pakistan
# API side (emails, SMS, OpenAPI title)
BRAND_NAME=Tahaif
APP_NAME=Tahaif API

# ── Bank Transfer ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_BANK_IBAN=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=Tahaif Gifts — MCB Bank

# ── PostHog Analytics ─────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://tahaif.com

# ── Deployment ────────────────────────────────────────────────────────────────
# Reverse proxies in front of the API that append to X-Forwarded-For:
# 0 locally, 1 on Railway/Render/Fly, 2 with Cloudflare in front.
TRUSTED_PROXY_HOPS=0
# 1 = the API container also runs the background worker (notifications, FX).
# Set 0 when a separate service runs `arq app.workers.main.WorkerSettings`.
RUN_WORKER_IN_API=1
