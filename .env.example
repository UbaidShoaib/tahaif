# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://tahaif_user:tahaif_dev_password@localhost:5433/tahaif

# Connection pool per process (lower to 2–5 on serverless / free-tier Postgres)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# true when DATABASE_URL is a PgBouncer/Supavisor transaction pooler (e.g. Supabase port 6543)
DB_PGBOUNCER=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_random_64_char_string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Cookies are always Secure when ENVIRONMENT is staging/production.
COOKIE_SECURE=false
# Web origin allowed by CORS. Web and API must share a registrable domain
# (e.g. dev.tahaif.pk + api.dev.tahaif.pk) or the SameSite=Lax refresh cookie isn't sent.
FRONTEND_URL=http://localhost:3000

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# ── Background jobs ───────────────────────────────────────────────────────────
# Bearer token for POST /api/v1/internal/jobs/{outbox|fx}. Empty disables the endpoint.
# Alternatively run: python -m app.workers.run outbox|fx
JOBS_TOKEN=

# ── Meilisearch ───────────────────────────────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=change_me

# ── Object Storage (MinIO locally / S3 in prod) ───────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=tahaif-media
S3_PUBLIC_URL=http://localhost:9000/tahaif-media

# ── Payments ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_PUBLISHABLE_KEY=pk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me

JAZZCASH_MERCHANT_ID=change_me
JAZZCASH_PASSWORD=change_me
JAZZCASH_INTEGRITY_SALT=change_me

EASYPAISA_STORE_ID=change_me
EASYPAISA_STORE_PASSWORD=change_me

# ── Messaging ─────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=change_me
TWILIO_AUTH_TOKEN=change_me
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+1234567890

RESEND_API_KEY=re_change_me
EMAIL_FROM=noreply@tahaif.com

# ── FX Rates ──────────────────────────────────────────────────────────────────
OPENEXCHANGERATES_APP_ID=change_me

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
ENVIRONMENT=development

# ── Frontend (Next.js public vars) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_change_me
NEXT_PUBLIC_MEILISEARCH_URL=http://localhost:7700
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=change_me

# ── Bank Transfer ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_BANK_IBAN=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=Tahaif Gifts — MCB Bank

# ── PostHog Analytics ─────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://tahaif.com
