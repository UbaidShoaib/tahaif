FROM node:22-alpine AS base
RUN npm install -g pnpm

# ---- deps ----
# Build context is the repo root (this is a pnpm workspace) so the
# lockfile and workspace manifest must come along, not just the app's
# own package.json.
FROM base AS deps
WORKDIR /app
COPY pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --frozen-lockfile --ignore-scripts --filter=tahaif-web...

# ---- builder ----
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web apps/web
ENV NEXT_TELEMETRY_DISABLED=1
# NEXT_PUBLIC_* are inlined at build time. docker-compose.prod.yml passes the
# server's .env.prod as a secret; only its public lines are kept, because Next
# copies .env.production into the standalone output.
# A secret's content is not part of the build cache key, so WEB_ENV_HASH (a
# hash of those lines, set by infra/deploy.sh) is what triggers a rebuild.
ARG WEB_ENV_HASH=
RUN --mount=type=secret,id=web_env \
    if [ -f /run/secrets/web_env ]; then \
      grep -E '^NEXT_PUBLIC_[A-Z0-9_]+=' /run/secrets/web_env > apps/web/.env.production || true; \
    fi; \
    pnpm --filter=tahaif-web build

# ---- runner ----
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs

# next.config.ts sets outputFileTracingRoot to the monorepo root, so the
# standalone bundle mirrors the workspace path (apps/web/server.js)
# instead of landing at the app root.
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public

USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/web/server.js"]
