FROM python:3.12-slim AS base
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1

FROM base AS builder
RUN pip install uv
COPY apps/api/pyproject.toml apps/api/uv.lock apps/api/
# Dependencies only: the app source is copied into the runtime stage and run from
# its working directory, so the project itself doesn't need installing.
RUN cd apps/api && uv sync --no-dev --frozen --no-install-project

FROM base AS runtime
RUN addgroup --system app && adduser --system --ingroup app app
COPY --from=builder /app/apps/api/.venv /app/apps/api/.venv
COPY apps/api/app apps/api/app
COPY apps/api/alembic apps/api/alembic
COPY apps/api/alembic.ini apps/api/alembic.ini
COPY apps/api/scripts apps/api/scripts
# `app` package and alembic.ini are resolved from here.
WORKDIR /app/apps/api
ENV PATH="/app/apps/api/.venv/bin:$PATH" \
    PORT=8000 \
    WEB_CONCURRENCY=2
USER app
EXPOSE 8000
# PORT is set by Cloud Run / Render / Koyeb; WEB_CONCURRENCY is read by uvicorn.
# Migrations:   alembic upgrade head
# Scheduled jobs: python -m app.workers.run outbox|fx
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --proxy-headers --forwarded-allow-ips='*'"]
