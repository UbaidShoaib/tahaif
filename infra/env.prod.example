# Production settings for the VPS stack (infra/docker-compose.prod.yml).
# Copy to /opt/tahaif/.env.prod on the server and fill in. Never commit the real file.
# Generate secrets with: openssl rand -hex 32
# Leave optional lines commented out rather than empty — an empty value
# overrides the built-in default.

# ── Server ────────────────────────────────────────────────────────────────────
DOMAIN=example.com
# Let's Encrypt contact address.
ACME_EMAIL=you@example.com

# ── Secrets (hex only: the database password goes into a URL) ────────────────
SECRET_KEY=change_me
POSTGRES_PASSWORD=change_me
MEILISEARCH_MASTER_KEY=change_me
MINIO_ROOT_USER=tahaif
MINIO_ROOT_PASSWORD=change_me

# ── Web (baked in at build time: rebuild after changing) ─────────────────────
NEXT_PUBLIC_API_URL=https://example.com/api/v1
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_BRAND_NAME=Tahaif
NEXT_PUBLIC_BRAND_LOCAL_NAME=تحائف
NEXT_PUBLIC_BRAND_TAGLINE=Send Gifts Across Pakistan
# NEXT_PUBLIC_BRAND_LOGO_URL=
NEXT_PUBLIC_ENABLE_URDU=false
# NEXT_PUBLIC_IMAGE_HOSTS=
# NEXT_PUBLIC_BANK_IBAN=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=Tahaif Gifts — MCB Bank
# NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_HOURS=09:00-21:00
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_SENTRY_DSN=

# ── API ───────────────────────────────────────────────────────────────────────
BRAND_NAME=Tahaif
APP_NAME=Tahaif API
EMAIL_FROM=noreply@example.com
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# TWILIO_SMS_FROM=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OPEN_EXCHANGE_RATES_APP_ID=
# SENTRY_DSN=

# ── Tuning (optional) ─────────────────────────────────────────────────────────
# 2 if Cloudflare proxies in front of Caddy.
# TRUSTED_PROXY_HOPS=1
# WEB_CONCURRENCY=2
